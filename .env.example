# Leave empty when hosting at the domain root. Rebuild after changing it.
# This is the deployment prefix; /en and /zh-HK are added automatically.
NEXT_PUBLIC_BASE_PATH=

# Full public site URL, including the base path, used for SEO/share metadata.
# Do not include a locale segment in this URL.
NEXT_PUBLIC_SITE_URL=https://whhoaf.github.io/hksh-prototype/

# Public Bliss API origin. Rebuild after changing; no staff token is needed.
NEXT_PUBLIC_BOOKING_API_URL=http://localhost:3003

# Public tenant used for both venue bookings and class enrollment (defaults to 3).
NEXT_PUBLIC_BOOKING_TENANT_ID=3

# Backend place service IDs for each website court. Rebuild after changing.
# Leave a service ID empty to make that court unavailable.
NEXT_PUBLIC_VENUE_VB_A_SERVICE_ID=372
NEXT_PUBLIC_VENUE_VB_B_SERVICE_ID=373
NEXT_PUBLIC_VENUE_BB_SERVICE_ID=374
NEXT_PUBLIC_VENUE_PB_SERVICE_ID=
NEXT_PUBLIC_VENUE_BD_A_SERVICE_ID=
NEXT_PUBLIC_VENUE_BD_B_SERVICE_ID=
NEXT_PUBLIC_VENUE_FB_A_SERVICE_ID=
NEXT_PUBLIC_VENUE_FB_B_SERVICE_ID=
NEXT_PUBLIC_VENUE_DB_A_SERVICE_ID=
NEXT_PUBLIC_VENUE_DB_B_SERVICE_ID=
NEXT_PUBLIC_VENUE_TQ_A_SERVICE_ID=
NEXT_PUBLIC_VENUE_TQ_B_SERVICE_ID=

# Personal Training 個人訓練 service category; rebuild after changing.
NEXT_PUBLIC_PT_CATEGORY_ID=1790
NEXT_PUBLIC_PT_BRANCH_ID=14

# KPay return page; {locale} becomes en or zh-HK. Include any deployment prefix.
# Leave empty to return to this website origin and its localized confirmation page. Rebuild after changing.
NEXT_PUBLIC_KPAY_REDIRECT_URL="http://localhost:3001/{locale}/booking/confirmation/"
